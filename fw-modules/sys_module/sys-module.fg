/; sys module - System utilities
/; Provides access to command-line arguments, script directory, etc.
/; FFI Declarations (Layer 1: C runtime backend)
fun fg_get_arg_count() -> as int decl

fun fg_get_arg(index: as int) -> as str decl

fun fg_get_script_dir() -> as str decl

fun fg_exit(code: as int) -> as nthg decl

fun fg_timestamp() -> as int64 decl

fun fg_monotonic_nanos() -> as int64 decl

fun fw_sched_sleep_ms(ms: as int64) -> as nthg decl

fun fw_sched_yield() -> as nthg decl

fun fg_runtime_error(msg: as str) -> as nthg decl

fun fg_exec(cmd: as str) -> as str decl

fun fg_exec_status() -> as int decl
module [sys] /; Layer 2: namespace
/; Command-line argument access
/; Returns the argument at the given index (0 = program name), or "" when
/; there is no argument at that index, so optional arguments can be read
/; without checking getArgCount() first.
fun getArg(index: int) -> str {
    var c = fg_get_arg_count()
    if (index < 0 || index >= c) {
        return ""
    }
    return fg_get_arg(index)
}

fun getArgCount() -> int {
    return fg_get_arg_count()
}

/; Script directory (same as __script_dir__)
fun scriptDir() -> str {
    return fg_get_script_dir()
}

/; Terminate the process with the given exit code
fun exit(code: int) -> nthg {
    fg_exit(code)
}

/; Current Unix timestamp (seconds since epoch).
/; int64 because the C side returns long long, and because seconds since
/; 1970 no longer fit in a 32-bit int after 19 January 2038.
fun timestamp() -> int64 {
    return fg_timestamp()
}

/; Monotonic clock in nanoseconds. Use this for benchmarking, not timestamp():
/; timestamp() is seconds-resolution and jumps when the system clock changes.
/; The zero point is arbitrary, so only DIFFERENCES between readings mean
/; anything.
fun nanos() -> int64 {
    return fg_monotonic_nanos()
}

/; Same clock in microseconds. `/` is floating-point division in Flow-Wing, so
/; the result is truncated back to int64 rather than returned as a deci.
fun micros() -> int64 {
    return Int64(fg_monotonic_nanos() / 1000)
}

/; Same clock in milliseconds.
fun millis() -> int64 {
    return Int64(fg_monotonic_nanos() / 1000000)
}

/; Nanoseconds elapsed since an earlier nanos() reading.
fun elapsedNanos(start: int64) -> int64 {
    return fg_monotonic_nanos() - start
}

/; Wait `ms` milliseconds.
/;
/; Inside a spawned task this SUSPENDS the task: other queued work runs while
/; it waits, so N tasks each waiting 100ms finish in about 100ms total, not
/; N*100ms. Outside a task there is nothing to switch to, so it blocks.
fun sleep(ms: int64) -> nthg {
    fw_sched_sleep_ms(ms)
}

/; Give up the CPU so other queued tasks can run, then continue where we left
/; off. A no-op outside a task.
fun yield() -> nthg {
    fw_sched_yield()
}

/; Executes a shell command and returns its standard output.
/; Standard error is not captured; append " 2>&1" to the command to merge it.
fun exec(cmd: str) -> str {
    return fg_exec(cmd)
}

/; Executes a shell command and returns its exit code and standard output.
/; The exit code is what a shell would report in $?: 128 + N when the
/; command was killed by signal N, and -1 when it could not be started.
/; Standard error is not captured; append " 2>&1" to the command to merge it.
fun run(cmd: str) -> int, str {
    var out: str = fg_exec(cmd)
    return fg_exec_status(), out
}