/; FW_GC_STRESS
/; --------------------------------------------------------------------------
/; A multidimensional array as a spawn argument.
/;
/; A 2D array is a nested aggregate, so it is the hardest shape for the
/; element-by-element copy into the argument block: getting the element stride
/; wrong reads neighbouring rows rather than failing outright.
/;
/; The caller overwrites the whole grid after the spawn. The task must still
/; print the original values, because the copy was taken at the spawn site.
/; --------------------------------------------------------------------------

fun showGrid(g: int[2][3]) -> nthg {
  println("row0 " + String(g[0][0]) + " " + String(g[0][1]) + " " + String(g[0][2]))
  println("row1 " + String(g[1][0]) + " " + String(g[1][1]) + " " + String(g[1][2]))
}

var grid: int[2][3] = [[1, 2, 3], [4, 5, 6]]
spawn showGrid(grid)

grid[0][0] = 99
grid[1][2] = 99

println("overwrote the grid")
