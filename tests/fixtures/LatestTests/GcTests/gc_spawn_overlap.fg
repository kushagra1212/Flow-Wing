/; FW_GC_STRESS
/; --------------------------------------------------------------------------
/; The point of the whole exercise: waiting tasks OVERLAP.
/;
/; Three tasks each wait 500ms. Sequentially that is ~1500ms; overlapped it is
/; ~500ms, because sys::sleep inside a task parks it with a deadline and hands
/; the scheduler back control instead of blocking the thread.
/;
/; Three tasks rather than two so the margin is wide. The suite runs with
/; --parallel, so a two-task version's gap could be closed by CPU contention
/; alone and flake.
/;
/; WHY 500ms AND NOT 100ms
/;   At 100ms with a 200ms threshold this failed on the CI macOS runner:
/;   "overlapped: false". The overhead here is FW_GC_STRESS — a full collection
/;   on every allocation while three tasks start — and that cost depends on
/;   heap size, not on how long anything sleeps. So it is roughly CONSTANT
/;   while the sleep scales. Stretching the sleep widens the real signal
/;   without widening the noise:
/;
/;     100ms sleeps -> overlapped ~100 + overhead, threshold 200  (100ms slack)
/;     500ms sleeps -> overlapped ~500 + overhead, threshold 1000 (500ms slack)
/;
/;   Serial would be ~1500ms, so 1000ms still separates the two cleanly.
/;   Costs ~0.4s of extra suite time.
/;
/; Under FW_GC_STRESS this also exercises the reason the GC had to change: all
/; three tasks are parked on their own stacks at once, so their shadow chains
/; are invisible to fw_gc_shadow_top and only reachable through the scheduler's
/; aux root scanner.
/; --------------------------------------------------------------------------
bring sys

var t_first: int64 = 0
var started: int = 0
var reported: bool = false

fun slowTask() -> nthg {
  started = started + 1
  if started == 1 {
    t_first = sys::nanos()
  }

  sys::sleep(500)

  /; whichever task wakes first reports; the rest stay quiet
  if !reported {
    reported = true
    var total_ms: deci = sys::elapsedNanos(t_first) / 1e6
    println("overlapped: " + String(total_ms < 1000.0))
  }
}

spawn slowTask()
spawn slowTask()
spawn slowTask()
println("queued 3")
