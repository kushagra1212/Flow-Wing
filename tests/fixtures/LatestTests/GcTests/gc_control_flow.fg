/; FW_GC_STRESS
/; --------------------------------------------------------------------------
/; Control flow & frame-pop coverage. The shadow-frame epilogue is emitted
/; before EVERY `ret`, so a function with several exit paths must pop exactly
/; once per path. Loops with `break`/`continue` re-enter blocks that hold live
/; GC locals, and a loop-carried accumulator must survive every iteration's
/; allocations.
/; --------------------------------------------------------------------------

/; several return paths in one function: each `ret` needs its own frame pop
fun classify(n: int) -> str {
  if n < 0 {
    return "neg" + String(n)
  }
  if n == 0 {
    return "ze" + "ro"
  }
  var s: str = "pos" + String(n)
  return s
}
println(classify(-3))
println(classify(0))
println(classify(5))

/; while + continue + break, accumulating a heap string across iterations
var i: int = 0
var acc: str = ""
while i < 10 {
  i = i + 1
  if i == 3 {
    continue
  }
  if i == 8 {
    break
  }
  acc = acc + "i" + String(i)
}
println(acc)

/; nested loops with a skip in the inner one
var out: str = ""
for var a: int = 0 to 2 {
  for var b: int = 0 to 2 {
    if b == 1 {
      continue
    }
    out = out + String(a) + String(b) + "-"
  }
}
println(out)

/; early return out of a loop inside a function
fun findFirst(limit: int) -> str {
  var k: int = 0
  while k < limit {
    var probe: str = "p" + String(k)
    if k == 4 {
      return probe + "!"
    }
    k = k + 1
  }
  return "none"
}
println(findFirst(10))
println(findFirst(3))

/; a container filled from a loop that skips and stops early
bring vec
var v: vec::Vec = new vec::Vec()
var k: int = 0
while k < 8 {
  k = k + 1
  if k == 3 {
    continue
  }
  if k == 7 {
    break
  }
  v.push("w" + String(k))
}
println(v.size())
println(v.get(0))
println(v.get(3))

/; an object built inside a loop body, replaced each iteration (the previous
/; one becomes garbage immediately)
type Slot = { v: str }
var last: Slot = { v: "init" }
for var t: int = 0 to 5 {
  last = { v: "t" + String(t) }
}
println(last.v)
