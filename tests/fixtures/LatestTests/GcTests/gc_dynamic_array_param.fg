/; FW_GC_STRESS
/; --------------------------------------------------------------------------
/; Inline array-of-dynamics temp-safety. A by-value dynamic-array parameter copies
/; `[N x fg_dyn_type]` onto the stack — N independent boxed payloads, each of which
/; must be rooted (bug #10). Index-assignment of a fresh string into a dynamic
/; array element must also survive the subsequent print's allocations.
/; --------------------------------------------------------------------------

var a: [4] = [1, "two", 3.0, true]

fun mutate(x: [4]) -> nthg {
  println(x)
  x[2] = "Hello" + "World"   /; fresh string into a dynamic slot
  println(x)
  x[0] = "changed" + "!"
  println(x)
}

fun replace(inout a: [4], cb: [([4]) -> nthg]) -> nthg {
  println(a)
  a = [4, "fo" + "ur", 4.0, false]
  cb(a)
}

replace(a, mutate)
println(a)
