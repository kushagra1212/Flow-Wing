/; Chained assignment inside a for body, and an assignment expression as the
/; loop's upper bound.
var y: int = 0
var x: int = 0
for (var i: int = 0 to 3 : 1) {
    x = y = i
}
print(x, "\n")
print(y, "\n")

var bound: int = 0
var hits: int = 0
for (var j: int = 0 to (bound = 2) : 1) {
    hits = hits + 1
}
print(hits, "\n")
print(bound, "\n")
