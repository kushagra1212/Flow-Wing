/; Whole-object chained assignment. The inner assignment binds an object literal
/; into o2 and yields o2's storage; the outer store then copies o2 into o1.
type T = { v:int, s:str }
var o1:T = {v: 0, s: "a"}
var o2:T = {v: 0, s: "a"}
o1 = o2 = {v: 5, s: "five"}
println(o1)
println(o2)

/; and with the reassignment operator
var o3:T = {v: 0, s: "a"}
var o4:T = {v: 0, s: "a"}
o3 <- o4 <- {v: 9, s: "nine"}
println(o3)
println(o4)
