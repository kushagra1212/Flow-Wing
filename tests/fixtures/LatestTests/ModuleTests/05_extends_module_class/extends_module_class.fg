/; A class can extend a class another module declares: `extends shapes::Shape`.
/; Overrides, inherited methods, super(...) and calls through the module's
/; own type all reach the right code.
bring "shapes_module.fg"

class Square extends shapes::Shape {
  var side: deci
  init(side: deci) -> nthg {
    super("square")
    self.side = side
  }
  area() -> deci {
    return self.side * self.side
  }
}

/; Two levels: the grandparent is still the module's class.
class Cube extends Square {
  init(side: deci) -> nthg {
    super(side)
  }
  area() -> deci {
    return 6.0 * self.side * self.side
  }
}

var sq: Square = new Square(3.0)
println(sq.area())
println(sq.label())
println(sq.name)

var asShape: shapes::Shape = new Square(2.0)
println(asShape.area())
println(shapes::areaOf(sq))

var cube: shapes::Shape = new Cube(1.0)
println(cube.area())
println(cube.label())
