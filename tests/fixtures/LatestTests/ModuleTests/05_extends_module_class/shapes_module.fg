/; A module whose class other programs extend: extends_module_class.fg.
module [shapes]

class Shape {
  var name: str
  init(name: str) -> nthg {
    self.name = name
  }
  area() -> deci {
    return 0.0
  }
  label() -> str {
    return "shape " + self.name
  }
  corners() -> int {
    return 0
  }
  /; self.corners() reaches the override of a class another file declares.
  describe() -> str {
    return self.name + " has " + String(self.corners()) + " corners"
  }
}

/; Takes any Shape, so a subclass declared in another file reaches it.
fun areaOf(s: shapes::Shape) -> deci {
  return s.area()
}
