bring vortex
bring json
bring Err
fun fg_main() -> nthg {
    var app: vortex::Server = new vortex::Server()
    var err: Err::Result = app.listen(9922)
    if Err::isErr(err) {
        println(err.getMessage())
        return:
    }
    println("ready")
    for var i: int = 0 to 1 {
        var req: vortex::Request, res: vortex::Response = app.accept()
        println("-> " + req.getMethod() + " " + req.getPath() + " body=" + req.getBody())
        res.status(200).send("echo:" + req.getBody())
    }
}
fg_main()