bring raylib
bring vec
bring {SCREEN_WIDTH, SCREEN_HEIGHT } from "./Constants.fg"
bring {getTrackX, getTrackYaw } from "./Track.fg"
bring {RacingGame } from "./Game.fg"
bring {drawHUD, drawMenu, drawGameOver, drawPause } from "./UI.fg"
fun drawSky(win: raylib::Window, game: RacingGame, bgShift: deci32) -> nthg {
    var min_y: int = Int32(SCREEN_HEIGHT / 2)
    for (var y: int = 0 to min_y : 5) {
        var factor: deci32 = Decimal32(y) / Decimal32(min_y)
        var r: int = Int32(10.0f + (200.0f * factor))
        var g: int = Int32(5.0f + (50.0f * factor))
        var b: int = Int32(30.0f + (100.0f * factor))
        win.drawRectangle(new raylib::Vec2(0.0f, Decimal32(y)), new raylib::Vec2(Decimal32(SCREEN_WIDTH), 5.0f), new raylib::Color(r, g, b, 255))
    }
    var sunX: deci32 = (Decimal32(SCREEN_WIDTH) / 2.0f) - (game.playerX * 100.0f) - bgShift
    win.drawCircle(new raylib::Vec2(sunX, 150.0f), 100.0f, new raylib::Color(255, 50, 100, 255))
    for (var i: int = 0 to 5 : 1) {
        win.drawRectangle(new raylib::Vec2(sunX - 110.0f, 150.0f + Decimal32(i * 15)), new raylib::Vec2(220.0f, 5.0f), new raylib::Color(20, 5, 30, 255))
    }
    var mtnColor: raylib::Color = new raylib::Color(20, 10, 40, 255)
    for (var i: int = -5 to 5 : 1) {
        var mX: deci32 = Decimal32(i * 400) - bgShift
        win.drawTriangle(new raylib::Vec2(mX + 200.0f, Decimal32(min_y - 120)), new raylib::Vec2(mX, Decimal32(min_y)), new raylib::Vec2(mX + 400.0f, Decimal32(min_y)), mtnColor)
    }
}

fun drawObjects(win: raylib::Window, game: RacingGame, center_x: deci32, min_y: int, cameraTrackX: deci32, cameraZ: deci32, cameraYaw: deci32) -> nthg {
    var dist: deci32 = 8000.0f
    while dist > 0.0f {
        dist = dist - 200.0f
        for (var i: int = 0 to game.treeZ.size() - 1 : 1) {
            var tz: deci32 = Decimal32(game.treeZ.get(i))
            var distFromPlayer: deci32 = tz - game.pos
            if distFromPlayer > dist && distFromPlayer <= dist + 200.0f {
                var scale: deci32 = 500.0f / distFromPlayer
                var sy: deci32 = Decimal32(min_y) + (Decimal32(min_y) * scale)
                var absoluteTrackX: deci32 = getTrackX(tz)
                var dz_cam: deci32 = tz - cameraZ
                var viewX: deci32 = absoluteTrackX - cameraTrackX - (cameraYaw * dz_cam)
                var tx: deci32 = Decimal32(game.treeX.get(i))
                var sx: deci32 = center_x + ((viewX - (game.playerX * center_x)) * scale) + (tx * center_x * scale)
                var tw: deci32 = 300.0f * scale
                var th: deci32 = 600.0f * scale
                win.drawRectangle(new raylib::Vec2(sx - (tw * 0.08f), sy - (th * 0.3f)), new raylib::Vec2(tw * 0.16f, th * 0.3f), new raylib::Color(60, 40, 20, 255))
                win.drawCircle(new raylib::Vec2(sx, sy - (th * 0.35f)), tw * 0.45f, new raylib::Color(20, 60, 20, 255))
                win.drawCircle(new raylib::Vec2(sx, sy - (th * 0.55f)), tw * 0.35f, new raylib::Color(30, 90, 30, 255))
                win.drawCircle(new raylib::Vec2(sx, sy - (th * 0.75f)), tw * 0.25f, new raylib::Color(40, 120, 40, 255))
            }
        }
        for (var i: int = 0 to game.coinZ.size() - 1 : 1) {
            var cz: deci32 = Decimal32(game.coinZ.get(i))
            var distFromPlayer: deci32 = cz - game.pos
            var isActive: bool = Bool(game.coinActive.get(i))
            if isActive && distFromPlayer > dist && distFromPlayer <= dist + 200.0f {
                var scale: deci32 = 500.0f / distFromPlayer
                var sy: deci32 = Decimal32(min_y) + (Decimal32(min_y) * scale)
                var absoluteTrackX: deci32 = getTrackX(cz)
                var dz_cam: deci32 = cz - cameraZ
                var viewX: deci32 = absoluteTrackX - cameraTrackX - (cameraYaw * dz_cam)
                var cx: deci32 = Decimal32(game.coinX.get(i))
                var sx: deci32 = center_x + ((viewX - (game.playerX * center_x)) * scale) + (cx * center_x * scale)
                var cw: deci32 = 120.0f * scale
                var ch: deci32 = 120.0f * scale
                var hoverY: deci32 = raylib::getSin(game.time * 5.0f + Decimal32(i)) * (20.0f * scale)
                win.drawCircle(new raylib::Vec2(sx, sy - (ch * 0.5f) + hoverY), cw * 0.4f, new raylib::Color(218, 165, 32, 255))
                win.drawCircle(new raylib::Vec2(sx, sy - (ch * 0.5f) + hoverY), cw * 0.25f, new raylib::Color(255, 215, 0, 255))
                win.drawRectangle(new raylib::Vec2(sx - (cw * 0.05f), sy - (ch * 0.7f) + hoverY), new raylib::Vec2(cw * 0.1f, ch * 0.4f), new raylib::Color(255, 255, 255, 180))
            }
        }
        for (var i: int = 0 to game.oppZ.size() - 1 : 1) {
            var oz: deci32 = Decimal32(game.oppZ.get(i))
            var distFromPlayer: deci32 = oz - game.pos
            if distFromPlayer > dist && distFromPlayer <= dist + 200.0f {
                var scale: deci32 = 500.0f / distFromPlayer
                var sy: deci32 = Decimal32(min_y) + (Decimal32(min_y) * scale)
                var absoluteTrackX: deci32 = getTrackX(oz)
                var dz_cam: deci32 = oz - cameraZ
                var viewX: deci32 = absoluteTrackX - cameraTrackX - (cameraYaw * dz_cam)
                var ox: deci32 = Decimal32(game.oppX.get(i))
                var sx: deci32 = center_x + ((viewX - (game.playerX * center_x)) * scale) + (ox * center_x * scale)
                var cBody: raylib::Color = new raylib::Color(Int32(Decimal32(game.oppR.get(i))), Int32(Decimal32(game.oppG.get(i))), Int32(Decimal32(game.oppB.get(i))), 255)
                var cw: deci32 = 260.0f * scale
                var ch: deci32 = 100.0f * scale
                win.drawRectangle(new raylib::Vec2(sx - (cw / 1.8f), sy - (ch * 0.2f)), new raylib::Vec2(cw * 1.1f, ch * 0.3f), new raylib::Color(10, 10, 10, 180))
                win.drawRectangle(new raylib::Vec2(sx - (cw / 2.2f), sy - (ch * 0.4f)), new raylib::Vec2(cw * 0.25f, ch * 0.4f), new raylib::Color(15, 15, 15, 255))
                win.drawRectangle(new raylib::Vec2(sx + (cw / 2.2f) - (cw * 0.25f), sy - (ch * 0.4f)), new raylib::Vec2(cw * 0.25f, ch * 0.4f), new raylib::Color(15, 15, 15, 255))
                win.drawRectangle(new raylib::Vec2(sx - (cw / 2.0f), sy - (ch * 0.7f)), new raylib::Vec2(cw, ch * 0.5f), cBody)
                win.drawRectangle(new raylib::Vec2(sx - (cw / 2.8f), sy - ch), new raylib::Vec2(cw * 0.7f, ch * 0.3f), cBody)
                win.drawRectangle(new raylib::Vec2(sx - (cw / 3.2f), sy - (ch * 0.95f)), new raylib::Vec2(cw * 0.6f, ch * 0.25f), new raylib::Color(40, 50, 70, 255))
                win.drawRectangle(new raylib::Vec2(sx - (cw / 2.2f), sy - (ch * 0.6f)), new raylib::Vec2(cw * 0.25f, ch * 0.15f), new raylib::Color(255, 30, 30, 255))
                win.drawRectangle(new raylib::Vec2(sx + (cw / 2.2f) - (cw * 0.25f), sy - (ch * 0.6f)), new raylib::Vec2(cw * 0.25f, ch * 0.15f), new raylib::Color(255, 30, 30, 255))
                win.drawRectangle(new raylib::Vec2(sx - (cw / 1.9f), sy - (ch * 0.8f)), new raylib::Vec2(cw * 1.05f, ch * 0.08f), new raylib::Color(20, 20, 20, 255))
                win.drawRectangle(new raylib::Vec2(sx - (cw / 2.2f), sy - (ch * 0.8f)), new raylib::Vec2(cw * 0.05f, ch * 0.15f), new raylib::Color(20, 20, 20, 255))
                win.drawRectangle(new raylib::Vec2(sx + (cw / 2.2f) - (cw * 0.05f), sy - (ch * 0.8f)), new raylib::Vec2(cw * 0.05f, ch * 0.15f), new raylib::Color(20, 20, 20, 255))
            }
        }
    }
}

fun drawCar(win: raylib::Window, game: RacingGame) -> nthg {
    var cx: deci32 = Decimal32(SCREEN_WIDTH) / 2.0f
    var cy: deci32 = Decimal32(SCREEN_HEIGHT) - 180.0f
    var turn: deci32 = game.turnAnim
    var frontShift: deci32 = turn * 40.0f
    var cabShift: deci32 = turn * 20.0f
    var rearShift: deci32 = turn * 5.0f
    var cCyan: raylib::Color = new raylib::Color(0, 255, 255, 255)
    var cDarkCyan: raylib::Color = new raylib::Color(0, 150, 150, 255)
    var cBlack: raylib::Color = new raylib::Color(15, 15, 15, 255)
    var cGlass: raylib::Color = new raylib::Color(20, 20, 30, 255)
    win.drawRectangle(new raylib::Vec2(cx - 70.0f, cy + 40.0f), new raylib::Vec2(140.0f, 15.0f), new raylib::Color(0, 0, 0, 150))
    win.drawRectangle(new raylib::Vec2(cx - 55.0f + frontShift, cy - 10.0f), new raylib::Vec2(22.0f, 30.0f), cBlack)
    win.drawRectangle(new raylib::Vec2(cx + 33.0f + frontShift, cy - 10.0f), new raylib::Vec2(22.0f, 30.0f), cBlack)
    win.drawRectangle(new raylib::Vec2(cx - 45.0f + frontShift, cy - 5.0f), new raylib::Vec2(90.0f, 20.0f), cCyan)
    if turn < -0.05f {
        var w: deci32 = turn * -30.0f
        win.drawRectangle(new raylib::Vec2(cx + 65.0f + cabShift, cy - 5.0f), new raylib::Vec2(w, 35.0f), cDarkCyan)
    } else if turn > 0.05f {
        var w: deci32 = turn * 30.0f
        win.drawRectangle(new raylib::Vec2(cx - 65.0f - w + cabShift, cy - 5.0f), new raylib::Vec2(w, 35.0f), cDarkCyan)
    }
    win.drawRectangle(new raylib::Vec2(cx - 50.0f + cabShift, cy - 35.0f), new raylib::Vec2(100.0f, 45.0f), cCyan)
    win.drawRectangle(new raylib::Vec2(cx - 40.0f + cabShift, cy - 30.0f), new raylib::Vec2(80.0f, 15.0f), cGlass)
    win.drawRectangle(new raylib::Vec2(cx - 45.0f + cabShift, cy - 10.0f), new raylib::Vec2(90.0f, 25.0f), cGlass)
    win.drawRectangle(new raylib::Vec2(cx - 80.0f + rearShift, cy + 15.0f), new raylib::Vec2(40.0f, 35.0f), cBlack)
    win.drawRectangle(new raylib::Vec2(cx + 40.0f + rearShift, cy + 15.0f), new raylib::Vec2(40.0f, 35.0f), cBlack)
    win.drawRectangle(new raylib::Vec2(cx - 85.0f + rearShift, cy + 10.0f), new raylib::Vec2(170.0f, 30.0f), cCyan)
    win.drawRectangle(new raylib::Vec2(cx - 65.0f + rearShift, cy + 20.0f), new raylib::Vec2(130.0f, 15.0f), cBlack)
    if win.isKeyDown(raylib::KEY_UP) {
        var cFlame: raylib::Color = new raylib::Color(0, 255, 255, 200)
        var rad: deci32 = Decimal32(raylib::getRandomNumber(5, 12))
        win.drawCircle(new raylib::Vec2(cx - 40.0f + rearShift, cy + 30.0f), rad, cFlame)
        win.drawCircle(new raylib::Vec2(cx + 40.0f + rearShift, cy + 30.0f), rad, cFlame)
    }
    var cBrake: raylib::Color = win.isKeyDown(raylib::KEY_DOWN) ? new raylib::Color(255, 200, 200, 255) : new raylib::Color(255, 0, 0, 255)
    win.drawRectangle(new raylib::Vec2(cx - 60.0f + rearShift, cy + 22.0f), new raylib::Vec2(30.0f, 10.0f), cBrake)
    win.drawRectangle(new raylib::Vec2(cx + 30.0f + rearShift, cy + 22.0f), new raylib::Vec2(30.0f, 10.0f), cBrake)
    win.drawRectangle(new raylib::Vec2(cx - 15.0f + rearShift, cy + 20.0f), new raylib::Vec2(30.0f, 12.0f), new raylib::Color(255, 255, 255, 255))
    win.drawRectangle(new raylib::Vec2(cx - 95.0f + cabShift, cy - 2.0f), new raylib::Vec2(190.0f, 10.0f), cBlack)
    win.drawRectangle(new raylib::Vec2(cx - 85.0f + cabShift, cy + 5.0f), new raylib::Vec2(15.0f, 15.0f), cBlack)
    win.drawRectangle(new raylib::Vec2(cx + 70.0f + cabShift, cy + 5.0f), new raylib::Vec2(15.0f, 15.0f), cBlack)
}
expose fun renderGame(win: raylib::Window, game: RacingGame) -> nthg {
    var cGrassDark: raylib::Color = new raylib::Color(25, 100, 25, 255)
    var cGrassLight: raylib::Color = new raylib::Color(35, 120, 35, 255)
    var cRoadDark: raylib::Color = new raylib::Color(60, 60, 65, 255)
    var cRoadLight: raylib::Color = new raylib::Color(80, 80, 85, 255)
    var cRumbleRed: raylib::Color = new raylib::Color(220, 20, 60, 255)
    var cRumbleWhite: raylib::Color = new raylib::Color(255, 255, 255, 255)
    var center_x: deci32 = Decimal32(SCREEN_WIDTH) / 2.0f
    var min_y: int = Int32(SCREEN_HEIGHT / 2)
    var cameraZ: deci32 = game.pos + 940.0f
    var cameraTrackX: deci32 = getTrackX(cameraZ)
    var cameraYaw: deci32 = getTrackYaw(cameraZ)
    var bgShift: deci32 = cameraYaw * 600.0f
    drawSky(win, game, bgShift)
    for (var y: int = SCREEN_HEIGHT to min_y : -1) {
        var scale: deci32 = Decimal32(y - min_y) / Decimal32(min_y)
        if scale <= 0.0f {
            continue
        }
        var worldZ: deci32 = game.pos + (500.0f / scale)
        var absoluteTrackX: deci32 = getTrackX(worldZ)
        var dz_cam: deci32 = worldZ - cameraZ
        var viewX: deci32 = absoluteTrackX - cameraTrackX - (cameraYaw * dz_cam)
        var cx: deci32 = center_x + ((viewX - (game.playerX * center_x)) * scale)
        var w: deci32 = center_x * scale
        var rw: deci32 = w + (40.0f * scale)
        var isDark: bool = (Int32(worldZ / 300.0f) % 2) == 0
        win.drawRectangle(new raylib::Vec2(0.0f, Decimal32(y)), new raylib::Vec2(Decimal32(SCREEN_WIDTH), 1.0f), (isDark ? cGrassDark : cGrassLight))
        win.drawRectangle(new raylib::Vec2(cx - rw, Decimal32(y)), new raylib::Vec2(rw * 2.0f, 1.0f), (isDark ? cRumbleRed : cRumbleWhite))
        win.drawRectangle(new raylib::Vec2(cx - w, Decimal32(y)), new raylib::Vec2(w * 2.0f, 1.0f), (isDark ? cRoadDark : cRoadLight))
        if !isDark {
            var cw: deci32 = 12.0f * scale
            win.drawRectangle(new raylib::Vec2(cx - cw, Decimal32(y)), new raylib::Vec2(cw * 2.0f, 1.0f), cRumbleWhite)
        }
    }
    drawObjects(win, game, center_x, min_y, cameraTrackX, cameraZ, cameraYaw)
    drawCar(win, game)
    if game.crashFlash > 0.0f {
        var alpha: int = Int32(game.crashFlash * 300.0f)
        if alpha > 255 {
            alpha = 255
        }
        win.drawRectangle(new raylib::Vec2(0.0f, 0.0f), new raylib::Vec2(Decimal32(SCREEN_WIDTH), Decimal32(SCREEN_HEIGHT)), new raylib::Color(255, 0, 0, alpha))
    }
    if game.state == 1 {
        drawHUD(win, game)
    } else if game.state == 0 {
        drawMenu(win, game)
    } else if game.state == 2 {
        drawGameOver(win, game)
    } else if game.state == 3 {
        drawPause(win, game)
    }
}