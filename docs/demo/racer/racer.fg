bring raylib
bring vec
bring file
bring Err

const SCREEN_WIDTH: int = 1024
const SCREEN_HEIGHT: int = 768

class RacingGame {
    var pos: deci32
    var playerX: deci32
    var speed: deci32
    var maxSpeed: deci32
    var time: deci32
    var turnAnim: deci32
    var score: int
    var highScore: int
    var crashFlash: deci32
    var gameState: int /; 0: Menu, 1: Playing, 2: GameOver

    /; --- Environment & Opponents (Parallel Arrays) ---
    var oppZ: vec::Vec
    var oppX: vec::Vec
    var oppSpeed: vec::Vec
    var oppType: vec::Vec /; 0: Red, 1: Blue, 2: Yellow

    var treeZ: vec::Vec
    var treeX: vec::Vec

    init() -> nthg {
        self.gameState = 0
        self.loadHighScore()
        self.resetGame()
    }

    fun loadHighScore() -> nthg {
        var hsPath: str = file::__DIR__ + "/highscore.txt"
        var content: str, err: Err::Result = file::readText(hsPath)
        if err.isOk() {
            self.highScore = Int32(content)
        } else {
            self.highScore = 0
        }
    }

    fun saveHighScore() -> nthg {
        var hsPath: str = file::__DIR__ + "/highscore.txt"
        file::writeText(hsPath, String(self.highScore))
    }

    fun resetGame() -> nthg {
        self.pos = 0.0f
        self.playerX = 0.0f
        self.speed = 0.0f
        self.maxSpeed = 1600.0f
        self.time = 0.0f
        self.turnAnim = 0.0f
        self.score = 0
        self.crashFlash = 0.0f

        self.oppZ = new vec::Vec()
        self.oppX = new vec::Vec()
        self.oppSpeed = new vec::Vec()
        self.oppType = new vec::Vec()
        self.treeZ = new vec::Vec()
        self.treeX = new vec::Vec()

        for (var i: int = 0 to 14 : 1) {
            self.oppZ.push(1000.0f + Decimal32(i * 1200))
            self.oppX.push((Decimal32(raylib::getRandomNumber(0, 2)) * 0.7f) - 0.7f)
            self.oppSpeed.push(Decimal32(raylib::getRandomNumber(700, 1100)))
            self.oppType.push(raylib::getRandomNumber(0, 2))
        }

        for (var i: int = 0 to 49 : 1) {
            self.treeZ.push(Decimal32(i * 500))
            self.treeX.push((i % 2 == 0) ? -2.2f : 2.2f)
        }
    }

    fun getTrackX(z: deci32) -> deci32 {
        var curve1: deci32 = raylib::getSin(z * 0.0003f) * 2000.0f
        var curve2: deci32 = raylib::getSin(z * 0.00015f) * 1500.0f
        return curve1 + curve2
    }

    fun update(dt: deci32, win: raylib::Window) -> nthg {
        if self.gameState == 0 {
            if win.isKeyPressed(257) { self.gameState = 1 } /; ENTER
            return :
        } or if self.gameState == 2 {
            if win.isKeyPressed(32) { self.resetGame(); self.gameState = 1 } /; SPACE
            return :
        }

        if self.crashFlash > 0.0f { self.crashFlash = self.crashFlash - dt }

        /; Controls
        if win.isKeyDown(265) { self.speed = self.speed + (1000.0f * dt) } /; UP
        else if win.isKeyDown(264) { self.speed = self.speed - (1500.0f * dt) } /; DOWN
        else { self.speed = self.speed - (400.0f * dt) }

        if self.speed > self.maxSpeed { self.speed = self.maxSpeed }
        if self.speed < 0.0f { self.speed = 0.0f }

        var steer: deci32 = 1.2f * (self.speed / self.maxSpeed)
        var targetTurn: deci32 = 0.0f
        if win.isKeyDown(263) { self.playerX = self.playerX - (steer * dt); targetTurn = -1.0f } /; LEFT
        if win.isKeyDown(262) { self.playerX = self.playerX + (steer * dt); targetTurn = 1.0f } /; RIGHT
        
        self.turnAnim = self.turnAnim + ((targetTurn - self.turnAnim) * 8.0f * dt)

        /; Physics & Collision
        var lookAheadZ: deci32 = self.pos + 1500.0f
        var currentZ: deci32 = self.pos + 500.0f
        var curveDelta: deci32 = self.getTrackX(lookAheadZ) - self.getTrackX(currentZ)
        self.playerX = self.playerX - (curveDelta * 0.0002f * (self.speed / self.maxSpeed) * dt)

        for (var i: int = 0 to self.oppZ.size() - 1 : 1) {
            var oz: deci32 = Decimal32(self.oppZ.get(i))
            oz = oz + (Decimal32(self.oppSpeed.get(i)) * dt)
            
            var dz: deci32 = oz - self.pos
            if dz > 0.0f && dz < 150.0f {
                var diffX: deci32 = Decimal32(self.oppX.get(i)) - self.playerX
                if (diffX < 0.4f && diffX > -0.4f) {
                    self.speed = 200.0f
                    self.crashFlash = 0.5f
                    self.score = self.score - 50
                }
            }

            if oz < self.pos - 500.0f {
                oz = self.pos + 8000.0f
                self.score = self.score + 100
                if self.score > self.highScore { self.highScore = self.score; self.saveHighScore() }
            }
            self.oppZ.set(i, oz)
        }

        self.pos = self.pos + (self.speed * dt)
        self.time = self.time + dt
        if self.playerX > 2.0f || self.playerX < -2.0f { self.gameState = 2 } /; Died off-road
    }

    fun draw(win: raylib::Window) -> nthg {
        self.drawSky(win)
        var center_x: deci32 = Decimal32(SCREEN_WIDTH) / 2.0f
        var min_y: int = Int32(SCREEN_HEIGHT / 2)
        var cameraTrackX: deci32 = self.getTrackX(self.pos + 500.0f)
        var cameraX: deci32 = cameraTrackX + (self.playerX * center_x)

        for (var y: int = SCREEN_HEIGHT to min_y : -2) {
            var scale: deci32 = Decimal32(y - min_y) / Decimal32(min_y)
            if scale <= 0.0f { continue }
            var worldZ: deci32 = self.pos + (500.0f / scale)
            var cx: deci32 = center_x + ((self.getTrackX(worldZ) - cameraX) * scale)
            var w: deci32 = center_x * scale
            var isDark: bool = (Int32(worldZ / 300.0f) % 2) == 0
            win.drawRectangle(new raylib::Vec2(0.0f, Decimal32(y)), new raylib::Vec2(Decimal32(SCREEN_WIDTH), 2.0f), isDark ? new raylib::Color(30, 120, 30, 255) : new raylib::Color(40, 150, 40, 255))
            win.drawRectangle(new raylib::Vec2(cx - w, Decimal32(y)), new raylib::Vec2(w * 2.0f, 2.0f), isDark ? new raylib::Color(100, 100, 100, 255) : new raylib::Color(120, 120, 120, 255))
        }

        self.drawObjects(win, center_x, min_y, cameraX)
        self.drawCar(win)
        if self.crashFlash > 0.0f { win.drawRectangle(new raylib::Vec2(0.0f, 0.0f), new raylib::Vec2(Decimal32(SCREEN_WIDTH), Decimal32(SCREEN_HEIGHT)), new raylib::Color(255, 0, 0, 100)) }
        self.drawHUD(win)

        if self.gameState == 0 {
            win.drawRectangle(new raylib::Vec2(0.0f, 0.0f), new raylib::Vec2(Decimal32(SCREEN_WIDTH), Decimal32(SCREEN_HEIGHT)), new raylib::Color(0,0,0,180))
            win.drawText("FLOW-WING RACER", 280, 300, 60, new raylib::Color(255,255,0,255))
            win.drawText("PRESS ENTER TO START", 360, 400, 25, new raylib::Color(255,255,255,255))
        } or if self.gameState == 2 {
            win.drawText("GAME OVER", 380, 300, 50, new raylib::Color(255,0,0,255))
            win.drawText("PRESS SPACE TO RESTART", 360, 400, 25, new raylib::Color(255,255,255,255))
        }
    }

    fun drawObjects(win: raylib::Window, center_x: deci32, min_y: int, cameraX: deci32) -> nthg {
        var dist: deci32 = 6000.0f
        while dist > 0.0f {
            dist = dist - 200.0f
            /; Opponent Car Sudo-3D
            for (var i: int = 0 to self.oppZ.size() - 1 : 1) {
                var oz: deci32 = Decimal32(self.oppZ.get(i))
                var dz: deci32 = oz - self.pos
                if dz > dist && dz < dist + 200.0f {
                    var scale: deci32 = 500.0f / dz
                    var sx: deci32 = center_x + ((self.getTrackX(oz) - cameraX) * scale) + (Decimal32(self.oppX.get(i)) * center_x * scale)
                    var sy: deci32 = Decimal32(min_y) + (Decimal32(min_y) * scale)
                    var w: deci32 = 250.0f * scale
                    win.drawRectangle(new raylib::Vec2(sx - w, sy - (w * 0.6f)), new raylib::Vec2(w * 2.0f, w * 0.6f), new raylib::Color(20, 20, 20, 255)) /; 3D Rear
                    win.drawRectangle(new raylib::Vec2(sx - (w*0.8f), sy - (w * 0.5f)), new raylib::Vec2(w * 1.6f, w * 0.4f), new raylib::Color(0, 100, 255, 255))
                }
            }
        }
    }

    fun drawSky(win: raylib::Window) -> nthg {
        var min_y: int = Int32(SCREEN_HEIGHT / 2)
        for (var y: int = 0 to min_y : 10) {
            var factor: deci32 = Decimal32(y) / Decimal32(min_y)
            win.drawRectangle(new raylib::Vec2(0.0f, Decimal32(y)), new raylib::Vec2(Decimal32(SCREEN_WIDTH), 10.0f), new raylib::Color(Int32(15.0f + 200.0f*factor), 20, Int32(40.0f + 180.0f*factor), 255))
        }
        win.drawCircle(new raylib::Vec2(center_x, 150.0f), 60.0f, new raylib::Color(255, 255, 0, 255))
    }

    fun drawCar(win: raylib::Window) -> nthg {
        var cx: deci32 = Decimal32(SCREEN_WIDTH) / 2.0f
        var cy: deci32 = Decimal32(SCREEN_HEIGHT) - 180.0f
        var turn: deci32 = self.turnAnim
        win.drawRectangle(new raylib::Vec2(cx - 80.0f + (turn * 10.0f), cy + 10.0f), new raylib::Vec2(160.0f, 30.0f), new raylib::Color(200, 20, 20, 255))
        win.drawRectangle(new raylib::Vec2(cx - 50.0f + (turn * 30.0f), cy - 20.0f), new raylib::Vec2(100.0f, 30.0f), new raylib::Color(40, 40, 40, 255))
    }

    fun drawHUD(win: raylib::Window) -> nthg {
        var hudY: int = SCREEN_HEIGHT - 130
        win.drawRectangle(new raylib::Vec2(0.0f, Decimal32(hudY)), new raylib::Vec2(Decimal32(SCREEN_WIDTH), 130.0f), new raylib::Color(20, 20, 25, 255))
        win.drawText("SPEED: " + String(Int32(self.speed / 8.0f)), 50, hudY + 40, 40, new raylib::Color(0, 255, 255, 255))
        win.drawText("HIGH SCORE: " + String(self.highScore), 370, hudY + 35, 25, new raylib::Color(255, 255, 0, 255))
        win.drawText("SCORE: " + String(self.score), 370, hudY + 70, 25, new raylib::Color(0, 255, 255, 255))
    }
}

fun fg_main() -> int {
    var win: raylib::Window = new raylib::Window(SCREEN_WIDTH, SCREEN_HEIGHT, "Flow-Wing Ultra Racer")
    var game: RacingGame = new RacingGame()
    while !win.shouldClose() {
        var dt: deci32 = win.getFrameTime()
        game.update(dt, win)
        win.begin()
        win.clear(new raylib::Color(0, 0, 0, 255))
        game.draw(win)
        win.end()
    }
    return 0
}
fg_main()