bring raylib
bring vec
bring file
bring Err
bring {KEY_ENTER, KEY_P } from "./Constants.fg"
bring {getTrackX } from "./Track.fg"
expose class RacingGame {
    var state: int
    /; 0: Menu, 1: Playing, 2: Game Over, 3: Pause
    var pos: deci32
    var playerX: deci32
    var speed: deci32
    var maxSpeed: deci32
    var time: deci32
    var turnAnim: deci32
    var score: int
    var highScore: int
    var health: deci32
    var crashFlash: deci32
    var oppZ: vec::Vec
    var oppX: vec::Vec
    var oppSpeed: vec::Vec
    var oppR: vec::Vec
    var oppG: vec::Vec
    var oppB: vec::Vec
    var treeZ: vec::Vec
    var treeX: vec::Vec
    var coinZ: vec::Vec
    var coinX: vec::Vec
    var coinActive: vec::Vec
    init() -> nthg {
        self.oppZ = new vec::Vec()
        self.oppX = new vec::Vec()
        self.oppSpeed = new vec::Vec()
        self.oppR = new vec::Vec()
        self.oppG = new vec::Vec()
        self.oppB = new vec::Vec()
        self.treeZ = new vec::Vec()
        self.treeX = new vec::Vec()
        self.coinZ = new vec::Vec()
        self.coinX = new vec::Vec()
        self.coinActive = new vec::Vec()
        self.highScore = 0
        self.loadHighScore()
        self.state = 0
        self.resetGame()
        for (var i: int = 0 to 99 : 1) {
            self.treeZ.push(Decimal32(i * 400))
            var side: deci32 = (i % 2 == 0) ? -1.8f : 1.8f
            self.treeX.push(side)
        }
    }
    fun loadHighScore() -> nthg {
        var path: str = file::__DIR__ + "/highscore.txt"
        if file::exists(path) {
            var content: str, err: Err::Result = file::readText(path)
            if !err.isErr() && content != "" {
                self.highScore = Int32(content)
            }
        }
    }
    fun saveHighScore() -> nthg {
        if self.score > self.highScore {
            self.highScore = self.score
        }
        var path: str = file::__DIR__ + "/highscore.txt"
        file::writeText(path, String(self.highScore))
    }
    fun resetGame() -> nthg {
        self.pos = 0.0f
        self.playerX = 0.0f
        self.speed = 0.0f
        self.maxSpeed = 1600.0f
        self.time = 0.0f
        self.turnAnim = 0.0f
        self.score = 0
        self.health = 100.0f
        self.crashFlash = 0.0f
        self.oppZ.clear()
        self.oppX.clear()
        self.oppSpeed.clear()
        self.oppR.clear()
        self.oppG.clear()
        self.oppB.clear()
        self.coinZ.clear()
        self.coinX.clear()
        self.coinActive.clear()
        for (var i: int = 0 to 14 : 1) {
            self.oppZ.push(1000.0f + Decimal32(i * 1200))
            var lane: int = raylib::getRandomNumber(0, 2)
            if lane == 0 {
                self.oppX.push(-0.7f)
            } else if lane == 1 {
                self.oppX.push(0.0f)
            } else {
                self.oppX.push(0.7f)
            }
            self.oppSpeed.push(Decimal32(raylib::getRandomNumber(600, 1100)))
            self.oppR.push(Decimal32(raylib::getRandomNumber(50, 255)))
            self.oppG.push(Decimal32(raylib::getRandomNumber(50, 255)))
            self.oppB.push(Decimal32(raylib::getRandomNumber(50, 255)))
        }
        for (var i: int = 0 to 19 : 1) {
            self.coinZ.push(800.0f + Decimal32(i * 800))
            var lane: int = raylib::getRandomNumber(0, 2)
            if lane == 0 {
                self.coinX.push(-0.7f)
            } else if lane == 1 {
                self.coinX.push(0.0f)
            } else {
                self.coinX.push(0.7f)
            }
            self.coinActive.push(true)
        }
    }
    fun update(dt: deci32, win: raylib::Window) -> nthg {
        if self.state == 0 {
            if win.isKeyPressed(KEY_ENTER) {
                self.resetGame()
                self.state = 1
            }
        } else if self.state == 1 {
            if win.isKeyPressed(KEY_P) {
                self.state = 3
            } else {
                self.updatePlaying(dt, win)
            }
        } else if self.state == 2 {
            if win.isKeyPressed(KEY_ENTER) {
                self.state = 0
            }
        } else if self.state == 3 {
            if win.isKeyPressed(KEY_P) {
                self.state = 1
            }
        }
    }
    fun updatePlaying(dt: deci32, win: raylib::Window) -> nthg {
        if self.crashFlash > 0.0f {
            self.crashFlash = self.crashFlash - dt
        }
        if win.isKeyDown(raylib::KEY_UP) {
            self.speed = self.speed + (1000.0f * dt)
            if self.speed > self.maxSpeed {
                self.speed = self.maxSpeed
            }
        } else if win.isKeyDown(raylib::KEY_DOWN) {
            self.speed = self.speed - (1500.0f * dt)
            if self.speed < 0.0f {
                self.speed = 0.0f
            }
        } else {
            self.speed = self.speed - (400.0f * dt)
            if self.speed < 0.0f {
                self.speed = 0.0f
            }
        }
        self.score = self.score + Int32((self.speed / self.maxSpeed) * 10.0f)
        var steerSpeed: deci32 = 1.2f * (self.speed / self.maxSpeed)
        if steerSpeed < 0.3f && self.speed > 0.0f {
            steerSpeed = 0.3f
        }
        var lookAheadZ: deci32 = self.pos + 1500.0f
        var currentZ: deci32 = self.pos + 940.0f
        var curveDelta: deci32 = getTrackX(lookAheadZ) - getTrackX(currentZ)
        var targetTurn: deci32 = 0.0f
        if win.isKeyDown(raylib::KEY_LEFT) {
            self.playerX = self.playerX - (steerSpeed * dt)
            targetTurn = -1.0f
        } else if win.isKeyDown(raylib::KEY_RIGHT) {
            self.playerX = self.playerX + (steerSpeed * dt)
            targetTurn = 1.0f
        } else {
            targetTurn = curveDelta * 0.001f
            if targetTurn > 1.0f {
                targetTurn = 1.0f
            }
            if targetTurn < -1.0f {
                targetTurn = -1.0f
            }
        }
        self.turnAnim = self.turnAnim + ((targetTurn - self.turnAnim) * 8.0f * dt)
        self.playerX = self.playerX - (curveDelta * 0.0002f * (self.speed / self.maxSpeed) * dt)
        if self.playerX > 1.2f || self.playerX < -1.2f {
            if self.speed > 400.0f {
                self.speed = self.speed - (2500.0f * dt)
            }
        }
        var playerZ: deci32 = self.pos + 940.0f
        for (var i: int = 0 to self.oppZ.size() - 1 : 1) {
            var oz: deci32 = Decimal32(self.oppZ.get(i))
            var ox: deci32 = Decimal32(self.oppX.get(i))
            var ospeed: deci32 = Decimal32(self.oppSpeed.get(i))
            oz = oz + (ospeed * dt)
            var dz: deci32 = oz - playerZ
            if dz > -60.0f && dz < 60.0f {
                var diffX: deci32 = ox - self.playerX
                if diffX < 0.0f {
                    diffX = diffX * -1.0f
                }
                if diffX < 0.45f {
                    self.speed = self.speed * 0.3f
                    self.health = self.health - 20.0f
                    self.crashFlash = 0.5f
                    if self.health <= 0.0f {
                        self.saveHighScore()
                        self.state = 2
                    }
                }
            }
            if oz < self.pos - 500.0f {
                oz = self.pos + 8000.0f
                self.score = self.score + 250
                var lane: int = raylib::getRandomNumber(0, 2)
                if lane == 0 {
                    self.oppX.set(i, -0.7f)
                } else if lane == 1 {
                    self.oppX.set(i, 0.0f)
                } else {
                    self.oppX.set(i, 0.7f)
                }
            }
            self.oppZ.set(i, oz)
        }
        for (var i: int = 0 to self.coinZ.size() - 1 : 1) {
            var cz: deci32 = Decimal32(self.coinZ.get(i))
            var cx: deci32 = Decimal32(self.coinX.get(i))
            var isActive: bool = Bool(self.coinActive.get(i))
            if isActive {
                var dz: deci32 = cz - playerZ
                if dz > -60.0f && dz < 60.0f {
                    var diffX: deci32 = cx - self.playerX
                    if diffX < 0.0f {
                        diffX = diffX * -1.0f
                    }
                    if diffX < 0.4f {
                        self.coinActive.set(i, false)
                        self.score = self.score + 1000
                        self.health = self.health + 5.0f
                        if self.health > 100.0f {
                            self.health = 100.0f
                        }
                    }
                }
            }
            if cz < self.pos - 500.0f {
                self.coinZ.set(i, self.pos + 8000.0f + Decimal32(raylib::getRandomNumber(0, 4000)))
                var lane: int = raylib::getRandomNumber(0, 2)
                if lane == 0 {
                    self.coinX.set(i, -0.7f)
                } else if lane == 1 {
                    self.coinX.set(i, 0.0f)
                } else {
                    self.coinX.set(i, 0.7f)
                }
                self.coinActive.set(i, true)
            }
        }
        self.pos = self.pos + (self.speed * dt)
        self.time = self.time + dt
        for (var i: int = 0 to self.treeZ.size() - 1 : 1) {
            var tz: deci32 = Decimal32(self.treeZ.get(i))
            if tz < self.pos - 500.0f {
                self.treeZ.set(i, tz + 40000.0f)
            }
        }
    }
}