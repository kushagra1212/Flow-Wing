/; =========================================================
/;  The Flow-Wing website, served by Flow-Wing
/;
/;  ---- Shape of this server ----
/;
/;  The accept loop is a TASK, not top-level code:
/;
/;      fg_main()  ->  spawn serverLoop(app)  ->  spawn handleRequest(req, res)
/;
/;  That matters. `spawn` only QUEUES work, and the queue drains after the
/;  top-level body has finished. This file used to run `while true { accept() }`
/;  directly inside fg_main, so:
/;
/;    - the loop never finished, so nothing spawned inside it could ever run
/;    - accept() saw fw_sched_in_task() == false and took the blocking branch,
/;      `uv_run(loop, UV_RUN_ONCE)`, which owns the thread until a connection
/;      arrives
/;
/;  The result was one request at a time, start to finish. A visitor loading the
/;  page waited behind whoever was ahead of them.
/;
/;  Once the loop is itself a task, accept() suspends instead of blocking, and
/;  the scheduler runs queued handlers while it waits for the next connection.
/;  Same shape as the portfolio site.
/;
/;  ---- POST /run and POST /compile ----
/;
/;  Both run docker through sys::run. Inside a task, with the vortex loop
/;  running, that suspends only the task while docker works, so other visitors
/;  keep being served. See runSandbox and compileProgram below.
/;
/;  ---- Configuration (environment) ----
/;
/;    FLOWWING_PLAYGROUND_SANDBOX    docker (default): every program runs in a
/;                                   throwaway container.
/;                                   host: runs the compiler, and /run runs the
/;                                   program, directly on this machine. For
/;                                   local development only: nothing is
/;                                   sandboxed.
/;    FLOWWING_PLAYGROUND_COMPILER   host mode: the FlowWing to use
/;                                   (default: flowwing on PATH)
/; =========================================================
bring vortex
bring file
bring text
bring io
bring Err
bring json
bring sys
bring mongo
bring map
/; =========================================================
/;  Shared state
/;
/;  Globals on purpose: a spawned task reads them without them being copied into
/;  every argument block. Written once in fg_main, read-only afterwards.
/;
/;  gEvents stays null when no Mongo URI was given. Every read of it is guarded
/;  by gTrackingOn, so the null is never dereferenced.
/; =========================================================
var gCurrentDir: str = "."
var gAdminPath: str = ""
var gAdminEventsPath: str = ""
var gEvents: mongo::Collection = null
var gTrackingOn: bool = false
var gSandbox: str = "docker"
var gHostCompiler: str = "flowwing"
/; Written by request tasks. Safe without locks: tasks share one thread and
/; switch only where they wait, never between a read and the write after it.
var gSubmissionCount: int = 0
var gCompileBusy: bool = false
var gCompileWaiting: int = 0
var gCompileCache: map::Map = new map::Map()
/; =========================================================
/;  GET / -> the landing page
/;
/;  template.html is read from disk on every request on purpose. The page is
/;  edited often during development, and caching it would mean restarting the
/;  server to see a change. Under the task scheduler this read SUSPENDS the
/;  handler rather than blocking the loop, so other requests keep moving while
/;  the threadpool does the read.
/; =========================================================
fun sendIndex(res: vortex::Response) -> nthg {
    var tplPath: str = gCurrentDir + "/template.html"
    var content: str, rerr: Err::Result = file::readText(tplPath)
    if Err::isErr(rerr) {
        res.status(500).header("Content-Type", "text/html").send("<h1>Missing template.html</h1>")
        return :
    }
    content = text::replace(content, "{{TITLE}}", "Flow-Wing")
    content = text::replace(content, "{{VERSION}}", "Build v1.0.0-rc.1")
    /; Exact Tagline Match
    content = text::replace(content, "{{TAGLINE}}", "Built on LLVM. Flow-Wing combines a strict static core with supported dynamic primitives.")
    content = text::replace(content, "{{DOCS_URL}}", "https://flow-wing-docs.vercel.app/")
    content = text::replace(content, "{{GITHUB_URL}}", "https://github.com/kushagra1212/Flow-Wing")
    content = text::replace(content, "{{RELEASE_URL}}", "https://github.com/kushagra1212/Flow-Wing/releases")
    content = text::replace(content, "{{CARD_1_TITLE}}", "Hybrid Type System")
    content = text::replace(content, "{{CARD_1_DESC}}", "Use strict type and class definitions for core architecture, or utilize supported dyn primitives for flexible variable assignments and scripting.")
    content = text::replace(content, "{{CARD_2_TITLE}}", "LLVM Backend")
    content = text::replace(content, "{{CARD_2_DESC}}", "Compiles directly to optimized machine code using the LLVM infrastructure. The toolchain produces native binaries for macOS, Windows, and Linux without requiring a heavy runtime or interpreter.")
    content = text::replace(content, "{{CARD_3_TITLE}}", "Standard Library")
    content = text::replace(content, "{{CARD_3_DESC}}", "Built-in modules cover core requirements including file I/O, JSON serialization, and system utilities. The SDK also includes integrated bindings for Raylib graphics and the Vortex HTTP framework.")
    /; Cards 4 and 5 cover what the first three left out: the runtime.
    /;
    /; Concurrency and async I/O were briefly two cards, which was wrong. They
    /; are one feature described from two ends. Waiting on a socket IS what a
    /; task does, so splitting them implied the language had two unrelated
    /; systems.
    /;
    /; Kept at the same level as the cards above: what it does for the reader,
    /; not how it is built. The internals belong in the docs, where they can be
    /; stated precisely instead of compressed into three lines.
    content = text::replace(content, "{{CARD_4_TITLE}}", "Concurrency")
    content = text::replace(content, "{{CARD_4_DESC}}", "Run thousands of tasks on a single thread with no callbacks, no async keywords, and no locks. Each task keeps its own stack, so code that waits on a timer, a file, or a network socket still reads straight down the page. Waiting tasks step aside and let the others run.")
    content = text::replace(content, "{{CARD_5_TITLE}}", "Automatic Memory")
    content = text::replace(content, "{{CARD_5_DESC}}", "Memory is managed for you. There is no manual free, no ownership model to learn, and no lifetime annotations to satisfy. A precise collector tracks exactly what is still reachable and reclaims everything else.")
    res.status(200).header("Content-Type", "text/html; charset=utf-8").send(content)
}

/; =========================================================
/;  Playground requests
/;
/;  The docs site calls /run and /compile from another origin, so both answer
/;  with Access-Control-Allow-Origin: *. That is safe here: no cookie or login
/;  is involved, and CORS would not stop a client that is not a browser anyway.
/;  What bounds the load is nginx's rate limit, and for /compile, one compile at
/;  a time.
/; =========================================================
var MAX_SOURCE_BYTES: int = 65536

fun allowCrossOrigin(res: vortex::Response) -> nthg {
    res.header("Access-Control-Allow-Origin", "*")
}

/; A folder of its own for one request. nanos() alone could repeat for two
/; requests in the same tick; the counter cannot.
fun newSubmissionDir() -> str {
    gSubmissionCount = gSubmissionCount + 1
    var dir: str = "/tmp/submissions/" + String(sys::nanos()) + "-" + String(gSubmissionCount)
    sys::exec("mkdir -p " + dir)
    return dir
}

/; Escapes a string for a JSON document built by hand. Control characters other
/; than these (the compiler's colour codes) stay raw; clients escape them
/; before JSON.parse, as template.html does.
fun jsonText(value: str) -> str {
    var out: str = text::replace(value, "\\", "\\\\")
    out = text::replace(out, "\"", "\\\"")
    out = text::replace(out, "\n", "\\n")
    out = text::replace(out, "\r", "")
    return out
}

/; =========================================================
/;  POST /run -> compile and run user code in a sandbox
/;
/;  This is THE EXECUTION ENGINE.
/;
/;  Request:  {"code": "...", "input": "..."}   input is the program's stdin
/;  Response: {"output": "...", "exitCode": N}
/;            exitCode 124: stopped by the time limit; 137: killed, usually by
/;            the memory limit.
/;
/;  Each request runs in its own task, and sys::run runs docker as a child
/;  process on the vortex loop: this task waits, up to the 20 second timeout
/;  below, while the loop keeps accepting and serving other visitors.
/; =========================================================
fun runSandbox(req: vortex::Request, res: vortex::Response) -> nthg {
    allowCrossOrigin(res)
    var body: str = req.getBody()
    /; json::parse reads a string in time proportional to its length squared.
    if text::length(body) > MAX_SOURCE_BYTES {
        res.status(413).header("Content-Type", "application/json").send("{\"output\": \"The program is larger than 64 KB.\", \"exitCode\": -1}")
        return :
    }
    var parsed: json::JsonNode = json::parse(body)
    var userCode: str = parsed.get("code").strVal
    var stdInput: str = parsed.get("input").strVal
    var subDir: str = newSubmissionDir()
    var tempFile: str = subDir + "/code.fg"
    var inFile: str = subDir + "/input.txt"
    file::writeText(tempFile, userCode)
    file::writeText(inFile, stdInput)
    /; 20s, not 5s. This budget covers the container STARTING and the user
    /; program running. Five seconds left almost nothing for the program once a
    /; cold container had eaten the rest. A runaway loop is still killed, just
    /; later.
    var cmd: str = "timeout 20s docker run --rm --network none --cpus=0.5 --memory=128m -v " + subDir + ":/sandbox:ro flowwing-sandbox sh -c 'flowwing-jit /sandbox/code.fg < /sandbox/input.txt 2>&1'"
    if gSandbox == "host" {
        /; macOS has no `timeout`: a runaway program here is stopped by hand.
        cmd = "'" + gHostCompiler + "' " + tempFile + " --emit=exe --progress=never --output-dir=" + subDir + "/build -o " + subDir + "/program 2>&1 && " + subDir + "/program < " + inFile + " 2>&1"
    }
    var exitCode: int, output: str = sys::run(cmd)
    /; Clean up the unique submission files immediately after execution
    sys::exec("rm -rf " + subDir)
    /; An empty result is indistinguishable from success in the UI: the console
    /; simply stays blank, which is what a cold start looked like. Empty means
    /; the container was killed by `timeout`, failed to start, or the program
    /; genuinely printed nothing. Say which.
    if output == "" {
        output = "[no output]\n\nThe program printed nothing, or the sandbox timed out.\nIf this was the first run after a deploy, press Run again: the container image was still warming up."
    }
    res.status(200).header("Content-Type", "application/json").send("{\"output\": \"" + jsonText(output) + "\", \"exitCode\": " + String(exitCode) + "}")
}

/; =========================================================
/;  POST /compile?target=wasm32|native&opt=0..3&wat=1 -> what the compiler makes
/;
/;  Request:  the program itself, as the body (text/plain).
/;  Response: the JSON document sandbox/compile.mjs prints: the LLVM IR, and
/;            for wasm32 the main.js + main.wasm the browser then runs.
/;
/;  One compile at a time: linking to wasm needs a few hundred MB, and this VM
/;  has one GB. Others wait their turn, up to MAX_COMPILE_WAITING, after which
/;  the answer is "busy". A program compiled before is answered from memory.
/; =========================================================
var MAX_COMPILE_WAITING: int = 8
var MAX_CACHED_COMPILES: int = 32

/; True if the query has exactly `pair` (e.g. "opt=2") as one of its parts.
fun queryHas(query: str, pair: str) -> bool {
    return text::indexOf("&" + query + "&", "&" + pair + "&") >= 0
}

fun compileProgram(req: vortex::Request, res: vortex::Response) -> nthg {
    allowCrossOrigin(res)
    res.header("Content-Type", "application/json")
    var source: str = req.getBody()
    if text::length(source) > MAX_SOURCE_BYTES {
        res.status(413).send("{\"ok\": false, \"stage\": \"request\", \"log\": [], \"diagnostics\": \"The program is larger than 64 KB.\"}")
        return :
    }

    /; The options are picked from fixed lists and never copied from the query:
    /; the command line below is built from these constants only.
    var query: str = req.getQuery()
    var args: str = " --target=wasm32"
    if queryHas(query, "target=native") {
        args = " --target=native"
    }
    if queryHas(query, "opt=1") {
        args = args + " --opt=1"
    } else if queryHas(query, "opt=2") {
        args = args + " --opt=2"
    } else if queryHas(query, "opt=3") {
        args = args + " --opt=3"
    }
    if queryHas(query, "wat=1") {
        args = args + " --wat"
    }

    var key: str = args + "\n" + source
    if gCompileCache.has(key) {
        var cached: str = gCompileCache.get(key)
        res.status(200).send(cached)
        return :
    }

    if gCompileWaiting >= MAX_COMPILE_WAITING {
        res.status(503).send("{\"ok\": false, \"stage\": \"busy\", \"log\": [], \"diagnostics\": \"The compile server is busy. Try again in a few seconds.\"}")
        return :
    }
    gCompileWaiting = gCompileWaiting + 1
    while gCompileBusy {
        sys::sleep(50)
    }
    gCompileWaiting = gCompileWaiting - 1
    gCompileBusy = true

    var subDir: str = newSubmissionDir()
    file::writeText(subDir + "/code.fg", source)
    var cmd: str = "timeout 90s docker run --rm --network none --cpus=1 --memory=512m --pids-limit=256 -v " + subDir + ":/sandbox:ro flowwing-wasm-sandbox node /opt/playground/compile.mjs /sandbox/code.fg" + args
    if gSandbox == "host" {
        cmd = "FLOWWING='" + gHostCompiler + "' node '" + gCurrentDir + "/sandbox/compile.mjs' " + subDir + "/code.fg" + args
    }
    var status: int, output: str = sys::run(cmd)
    gCompileBusy = false
    sys::exec("rm -rf " + subDir)

    /; compile.mjs always prints one JSON object. Anything else means the
    /; sandbox itself failed: the image is missing, docker is down, or the
    /; time limit (status 124) or memory limit (137) killed it.
    if !text::startsWith(output, "{") {
        io::printErrorLogln("compile sandbox failed with status " + String(status), "red")
        res.status(502).send("{\"ok\": false, \"stage\": \"sandbox\", \"log\": [], \"diagnostics\": \"The compile sandbox did not answer (status " + String(status) + "). If the server was just deployed, try again in a minute.\"}")
        return :
    }
    if gCompileCache.size() >= MAX_CACHED_COMPILES {
        gCompileCache.clear()
    }
    gCompileCache.set(key, output)
    res.status(200).send(output)
}

/; =========================================================
/;  GET /admin/<token>/events -> newest events as JSON
/;
/;  findSorted, not find. find() cannot express an order, so the server answers
/;  in natural order, oldest first, and a limit would then return the OLDEST
/;  2000 documents. That stays invisible until the collection outgrows the
/;  limit, at which point the dashboard silently freezes on old data. Requires
/;  the mongo module's findSorted.
/;
/;  Streamed, not concatenated. Nothing larger than one document is ever held.
/; =========================================================
fun sendAdminEvents(res: vortex::Response) -> nthg {
    if !gTrackingOn {
        res.status(503).header("Content-Type", "application/json").send("[]")
        return :
    }
    var cur: mongo::Cursor = gEvents.findSorted("{}", 2000, "{\"ts\": -1}")
    res.status(200).streamBegin("application/json")
    res.streamWrite("[")
    var s: str = cur.next()
    var first: bool = true
    while s != "" {
        if first {
            first = false
        } else {
            res.streamWrite(",")
        }
        res.streamWrite(s)
        s = cur.next()
    }
    res.streamWrite("]")
    res.streamEnd()
    cur.close()
}

/; Dynamically assign the correct MIME type.
/;
/; .js and .css were missing once and fell through to image/x-icon. A browser
/; will not execute a script served as an image, so any asset added here, the
/; tracker for one, would silently never run. The failure is invisible in the
/; server log.
fun mimeForAsset(p: text::Text) -> str {
    var contentType: str = "image/x-icon"
    if p.endsWith(".png") {
        contentType = "image/png"
    } else if p.endsWith(".js") {
        contentType = "text/javascript; charset=utf-8"
    } else if p.endsWith(".css") {
        contentType = "text/css; charset=utf-8"
    } else if p.endsWith(".svg") {
        contentType = "image/svg+xml"
    } else if p.endsWith(".html") {
        contentType = "text/html; charset=utf-8"
    } else if p.endsWith(".webmanifest") {
        contentType = "application/manifest+json"
    }
    return contentType
}

/; =========================================================
/;  One request. Runs as its own task.
/;
/;  Routes are ordered by how often they are hit, so the common case does the
/;  fewest comparisons. `new text::Text(path)` is built only in the /assets/
/;  branch, not for every request.
/; =========================================================
fun handleRequest(req: vortex::Request, res: vortex::Response) -> nthg {
    var method: str = req.getMethod()
    var path: str = req.getPath()
    /; === GET / -> the landing page ===
    if method == "GET" && path == "/" {
        sendIndex(res)
        return :
    }
    /; === GET /assets/* -> css / js / icons ===
    if method == "GET" {
        var pathAsText: text::Text = new text::Text(path)
        if pathAsText.startsWith("/assets/") {
            res.status(200).sendStaticFile(gCurrentDir + pathAsText.get(), mimeForAsset(pathAsText))
            return :
        }
    }
    /; === POST /track -> store one event ===
    /;
    /; Answers 204 even when tracking is off or the insert fails. The tracker
    /; uses sendBeacon and cannot act on an error anyway, and a visitor must
    /; never see the page degrade because analytics is down. Failures go to the
    /; server log, which is where someone can actually act on them.
    if method == "POST" && path == "/track" {
        var body: str = req.getBody()
        if gTrackingOn && body != "" {
            if !gEvents.insertOne(body) {
                io::printErrorLogln("track insert failed: " + mongo::lastError(), "red")
            }
        }
        res.status(204).send("")
        return :
    }
    /; === POST /run -> the sandbox ===
    if method == "POST" && path == "/run" {
        runSandbox(req, res)
        return :
    }
    /; === POST /compile -> IR, and wasm for the browser to run ===
    if method == "POST" && path == "/compile" {
        compileProgram(req, res)
        return :
    }
    /; === OPTIONS -> CORS preflight for the two above ===
    /;
    /; The docs playground sends text/plain, which needs no preflight; this is
    /; for clients that send application/json.
    if method == "OPTIONS" && (path == "/run" || path == "/compile") {
        res.status(204).header("Access-Control-Allow-Origin", "*").header("Access-Control-Allow-Methods", "POST, OPTIONS").header("Access-Control-Allow-Headers", "Content-Type").header("Access-Control-Max-Age", "86400").send("")
        return :
    }
    /; === GET /admin/<token>/events -> JSON feed ===
    if gAdminEventsPath != "" && method == "GET" && path == gAdminEventsPath {
        sendAdminEvents(res)
        return :
    }
    /; === GET /admin/<token> -> the dashboard ===
    if gAdminPath != "" && method == "GET" && path == gAdminPath {
        res.status(200).sendStaticFile(gCurrentDir + "/assets/admin.html", "text/html; charset=utf-8")
        return :
    }
    /; === everything else ===
    res.status(404).header("Content-Type", "text/html").send("<h1>404</h1>")
}

/; =========================================================
/;  The accept loop, as a task.
/;
/;  Two spawns matter here, and they do different jobs:
/;
/;    spawn serverLoop(app)      lets accept() SUSPEND instead of owning the
/;                               thread, so queued handlers get to run
/;    spawn handleRequest(...)   returns to accept() at once, so the kernel's
/;                               backlog keeps draining while a handler works
/; =========================================================
fun serverLoop(app: vortex::Server) -> nthg {
    while true {
        var req: vortex::Request, res: vortex::Response = app.accept()
        if req == null {
            continue
        }
        spawn handleRequest(req, res)
    }
}

/; =========================================================
/;  Analytics
/;
/;  Same shape as the portfolio site: the browser POSTs one JSON document per
/;  event to /track, and /admin/<token>/events reads them back newest first.
/;
/;  Both are OPTIONAL. Without a Mongo URI the server runs exactly as before:
/;  /track answers 204 and discards, /admin answers 404. A landing page must not
/;  refuse to boot because an analytics database is unreachable.
/; =========================================================
fun fg_main() -> nthg {
    gCurrentDir = file::__DIR__ == "" ? "." : file::__DIR__
    if sys::getEnv("FLOWWING_PLAYGROUND_SANDBOX") == "host" {
        gSandbox = "host"
    }
    if sys::getEnv("FLOWWING_PLAYGROUND_COMPILER") != "" {
        gHostCompiler = sys::getEnv("FLOWWING_PLAYGROUND_COMPILER")
    }
    var mongoUri: str = sys::getArg(1)
    var adminToken: str = sys::getArg(2)
    if mongoUri != "" {
        var mc: mongo::Client = new mongo::Client(mongoUri)
        if mc.isOk() {
            gEvents = mc.getCollection("flowwing", "events")
            gTrackingOn = true
            /; Never log mongoUri itself. An Atlas URI carries the password in
            /; plain text and this line would put it in `docker logs` on every
            /; start, where it persists on disk.
            io::printLogln("analytics on (db flowwing)", "green")
        } else {
            io::printErrorLogln("mongo connect failed: " + mongo::lastError(), "yellow")
        }
    } else {
        io::printLogln("analytics off (no MONGO_URI given)", "yellow")
    }
    if adminToken != "" {
        gAdminPath = "/admin/" + adminToken
        gAdminEventsPath = gAdminPath + "/events"
    }
    var app: vortex::Server = new vortex::Server()
    var err: Err::Result = app.listen(8080)
    if Err::isErr(err) {
        io::printErrorLogln("Failed to start server", "red")
        return :
    }
    /; Pre-warm the sandbox image.
    /;
    /; The first `docker run` of a cold image faults its layers in from disk,
    /; creates the container and starts the process. On a small VM that can
    /; exceed the whole timeout budget, so the FIRST person to press Run got a
    /; killed container and a blank console, while a second press worked because
    /; the image was warm by then.
    /;
    /; Backgrounded with `&`: sys::exec returns at once, so the accept loop
    /; starts serving immediately instead of waiting for the warm-up.
    if gSandbox == "host" {
        io::printErrorLogln("playground: HOST mode. /run and /compile run on this machine, unsandboxed. Local development only.", "yellow")
    } else {
        sys::exec("docker run --rm --network none flowwing-sandbox true >/dev/null 2>&1 &")
        sys::exec("docker run --rm --network none flowwing-wasm-sandbox true >/dev/null 2>&1 &")
        io::printLogln("warming the sandbox images in the background", "yellow")
    }
    io::printLogln("Flow-Wing Live Environment running at http://127.0.0.1:8080", "cyan")
    /; Queues the loop. It starts when fg_main returns and the top-level body
    /; finishes, which is exactly why the loop is not written inline here.
    spawn serverLoop(app)
}
fg_main()