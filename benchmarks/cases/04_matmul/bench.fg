bring sys

var reps: int = Int32(sys::getArg(1))
var N: int = 64
var a: int[64][64]
var b: int[64][64]
var c: int[64][64]
var checksum: int64 = 0
var r: int = 0

while (r < reps) {
  var i: int = 0
  while (i < N) {
    var j: int = 0
    while (j < N) {
      a[i][j] = ((i * 3) + (j * 7) + r) % 100
      b[i][j] = ((i * 5) + (j * 11) + r) % 100
      j = j + 1
    }
    i = i + 1
  }

  i = 0
  while (i < N) {
    var j: int = 0
    while (j < N) {
      var sum: int = 0
      var k: int = 0
      while (k < N) {
        sum = sum + (a[i][k] * b[k][j])
        k = k + 1
      }
      c[i][j] = sum
      j = j + 1
    }
    i = i + 1
  }

  i = 0
  while (i < N) {
    var j: int = 0
    while (j < N) {
      checksum = (checksum + Int64(c[i][j])) % 1000000007
      j = j + 1
    }
    i = i + 1
  }

  r = r + 1
}

println(checksum)
