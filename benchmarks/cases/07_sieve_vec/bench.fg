bring vec
bring sys

var n: int = Int32(sys::getArg(1))
var flags: vec::Vec = new vec::Vec()

var i: int = 0
while (i < n) {
  flags.push(1)
  i = i + 1
}

var p: int = 2
while ((p * p) < n) {
  if (flags.get(p) == 1) {
    var k: int = p * p
    while (k < n) {
      flags.set(k, 0)
      k = k + p
    }
  }
  p = p + 1
}

var count: int = 0
var j: int = 2
while (j < n) {
  if (flags.get(j) == 1) {
    count = count + 1
  }
  j = j + 1
}

println(count)
